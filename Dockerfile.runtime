# Use a lightweight node image for runtime
# This Dockerfile is platform-agnostic and uses dynamic TARGETARCH.
FROM node:20-slim
ARG TARGETARCH

WORKDIR /app

# Copy the built server artifacts from the build stage or volume
# For this compose setup, we assume the artifacts are in ./dist
COPY ./dist /app

# Expose the Code-OSS server port
EXPOSE 8443

# Start the server
# Note: The actual command might vary based on how Code-OSS is built.
# Usually it's something like ./bin/code-server
CMD ["./bin/code-server", "--host", "0.0.0.0", "--port", "8443", "--auth", "none"]
